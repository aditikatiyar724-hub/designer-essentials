{
  "$description": "Designer Essentials design tokens — the single source of truth for both runtimes. DTCG format ($value/$type). Run `node tokens/build.mjs` after editing: it regenerates assets/tokens.css for web and mobile/src/theme.ts for native. Never edit either output by hand.",

  "primitive": {
    "sky": {
      "900": { "$value": "#00429a", "$type": "color" },
      "700": { "$value": "#005dbc", "$type": "color" },
      "500": { "$value": "#007dcb", "$type": "color" }
    },
    "pink": {
      "400": { "$value": "#ff98bf", "$type": "color" },
      "200": { "$value": "#ffd4e5", "$type": "color" }
    },
    "coral": {
      "500": { "$value": "#f2564c", "$type": "color" },
      "600": { "$value": "#d94339", "$type": "color" }
    },
    "mint": { "400": { "$value": "#3ddc97", "$type": "color" } },
    "gold": { "400": { "$value": "#ffc857", "$type": "color" } },
    "white": { "$value": "#ffffff", "$type": "color" },
    "ink": {
      "900": { "$value": "#072744", "$type": "color" },
      "600": { "$value": "#3b5f80", "$type": "color" }
    },
    "alpha": {
      "white-18": { "$value": "rgba(255, 255, 255, 0.18)", "$type": "color" },
      "white-34": { "$value": "rgba(255, 255, 255, 0.34)", "$type": "color" },
      "white-92": { "$value": "rgba(255, 255, 255, 0.92)", "$type": "color" },
      "scrim-top": { "$value": "rgba(4, 24, 46, 0.25)", "$type": "color" },
      "haze-top": { "$value": "rgba(0, 66, 154, 0.28)", "$type": "color" },
      "haze-fade": { "$value": "rgba(0, 125, 203, 0)", "$type": "color" },
      "scrim-bottom": { "$value": "rgba(4, 24, 46, 0.6)", "$type": "color" }
    }
  },

  "color": {
    "bg-page": { "$value": "{primitive.sky.900}", "$type": "color" },
    "bg-stage": { "$value": "{primitive.sky.500}", "$type": "color" },
    "text-display": { "$value": "{primitive.white}", "$type": "color" },
    "text-script": { "$value": "{primitive.pink.400}", "$type": "color" },
    "text-onsky": { "$value": "{primitive.white}", "$type": "color" },
    "text-ink": { "$value": "{primitive.ink.900}", "$type": "color" },
    "text-muted": { "$value": "{primitive.ink.600}", "$type": "color" },
    "accent": { "$value": "{primitive.coral.500}", "$type": "color" },
    "accent-strong": { "$value": "{primitive.coral.600}", "$type": "color" },
    "positive": { "$value": "{primitive.mint.400}", "$type": "color" },
    "highlight": { "$value": "{primitive.gold.400}", "$type": "color" },
    "timer-low": { "$value": "{primitive.pink.200}", "$type": "color" }
  },

  "surface": {
    "glass": { "$value": "{primitive.alpha.white-18}", "$type": "color" },
    "glass-strong": { "$value": "{primitive.alpha.white-34}", "$type": "color" },
    "card": { "$value": "{primitive.alpha.white-92}", "$type": "color" },
    "border-glass": { "$value": "{primitive.alpha.white-34}", "$type": "color" },
    "scrim-top": { "$value": "{primitive.alpha.scrim-top}", "$type": "color" },
    "haze-top": { "$value": "{primitive.alpha.haze-top}", "$type": "color" },
    "haze-fade": { "$value": "{primitive.alpha.haze-fade}", "$type": "color" },
    "scrim-bottom": { "$value": "{primitive.alpha.scrim-bottom}", "$type": "color" }
  },

  "space": {
    "1": { "$value": 4, "$type": "dimension" },
    "2": { "$value": 8, "$type": "dimension" },
    "3": { "$value": 12, "$type": "dimension" },
    "4": { "$value": 16, "$type": "dimension" },
    "5": { "$value": 24, "$type": "dimension" },
    "6": { "$value": 32, "$type": "dimension" }
  },

  "radius": {
    "sm": { "$value": 10, "$type": "dimension" },
    "md": { "$value": 16, "$type": "dimension" },
    "lg": { "$value": 26, "$type": "dimension" },
    "pill": { "$value": 999, "$type": "dimension" }
  },

  "text": {
    "xs": { "$value": 11, "$type": "dimension" },
    "sm": { "$value": 13, "$type": "dimension" },
    "md": { "$value": 15, "$type": "dimension" },
    "lg": { "$value": 20, "$type": "dimension" },
    "2xl": { "$value": 52, "$type": "dimension" }
  },

  "font": {
    "display": {
      "$value": { "family": "Sansita", "weight": 900, "webStack": "\"Trebuchet MS\", system-ui, sans-serif", "nativeFace": "Sansita_900Black" },
      "$type": "fontFamily"
    },
    "script": {
      "$value": { "family": "Ballet", "weight": 400, "webStack": "\"Snell Roundhand\", \"Segoe Script\", cursive", "nativeFace": "Ballet_400Regular" },
      "$type": "fontFamily"
    },
    "ui": {
      "$value": { "family": "Sansita", "weight": 700, "webStack": "system-ui, -apple-system, \"Segoe UI\", sans-serif", "nativeFace": "Sansita_700Bold" },
      "$type": "fontFamily"
    }
  },

  "elevation": {
    "$description": "One token per depth, expanded to a CSS box-shadow on web and to iOS shadow* plus Android elevation on native. Never hand-tune a shadow per screen.",
    "float": {
      "$value": { "y": 10, "blur": 24, "color": "#002850", "opacity": 0.28, "android": 8 },
      "$type": "shadow"
    },
    "card": {
      "$value": { "y": 18, "blur": 48, "color": "#002446", "opacity": 0.38, "android": 16 },
      "$type": "shadow"
    },
    "sprite": {
      "$value": { "y": 6, "blur": 10, "color": "#002d5a", "opacity": 0.28, "android": 4 },
      "$type": "shadow"
    },
    "basket": {
      "$value": { "y": 10, "blur": 14, "color": "#002d5a", "opacity": 0.3, "android": 6 },
      "$type": "shadow"
    }
  },

  "easing": {
    "out": { "$value": [0.22, 1, 0.36, 1], "$type": "cubicBezier" },
    "pop": { "$value": [0.34, 1.56, 0.64, 1], "$type": "cubicBezier" }
  },

  "duration": {
    "fast": { "$value": 160, "$type": "duration" },
    "med": { "$value": 320, "$type": "duration" },
    "slow": { "$value": 620, "$type": "duration" }
  },

  "stage": {
    "$description": "The Figma frame the whole game is laid out against. Both runtimes scale this box to fit; nothing inside it is responsive.",
    "width": { "$value": 360, "$type": "dimension" },
    "height": { "$value": 800, "$type": "dimension" }
  },

  "control": {
    "min-target": { "$value": 44, "$type": "dimension" },
    "btn-min-height": { "$value": 52, "$type": "dimension" }
  },

  "player": {
    "$description": "The in-play basket, 20% down from the original 104x88 to make catching harder. hero-scale keeps the splash basket at its designed 272px regardless.",
    "width": { "$value": 83, "$type": "dimension" },
    "height": { "$value": 70, "$type": "dimension" },
    "hero-scale": { "$value": 3.277, "$type": "number" },
    "hero-lift": { "$value": 16, "$type": "dimension" }
  },

  "lockup": {
    "script-size": { "$value": 66, "$type": "dimension" },
    "script-drop": { "$value": 100, "$type": "dimension" },
    "script-tracking": { "$value": 3.8, "$type": "dimension" },
    "word-size": { "$value": 36.869, "$type": "dimension" },
    "word-offset-x": { "$value": 118, "$type": "dimension" },
    "word-offset-y": { "$value": 10, "$type": "dimension" },
    "top": { "$value": 56, "$type": "dimension" }
  },

  "haze": {
    "$description": "The blue wash down the top of the sky. Expressed as a share of stage height so the CSS gradient stop and the native gradient box agree.",
    "height-pct": { "$value": 42, "$type": "number" }
  },

  "panel": {
    "$description": "The start-screen panel sits this far above the stage floor, clearing the hero basket.",
    "bottom": { "$value": 248, "$type": "dimension" }
  },

  "cloudbank": {
    "$description": "Exact geometry of image 67152 in the Figma frame.",
    "width": { "$value": 558, "$type": "dimension" },
    "height": { "$value": 314, "$type": "dimension" },
    "left": { "$value": -138, "$type": "dimension" },
    "top": { "$value": 553, "$type": "dimension" }
  }
}
